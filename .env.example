# Copie para `.env` (`cp .env.example .env`).
DATABASE_URL="file:./dev.db"
PORT=3007

# Probabilidade (0 a 1) de o "provedor" de SMS falhar — útil para testar o retry.
SMS_FAILURE_RATE=0.2

# Limite de envios por contato por minuto (regra R7).
MAX_NOTIFICATIONS_PER_MINUTE=5

# Onde os dados vivem: `prisma` (SQLite) ou `memory` (sem banco, para demonstração/teste).
APP_STORAGE=prisma

# Provedor de e-mail: `log` (imprime no console) ou `smtp` (envia de verdade).
EMAIL_PROVIDER=log
# Preencha apenas com EMAIL_PROVIDER=smtp (ex.: conta de teste do Ethereal/Mailtrap).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@notificacoes.local
